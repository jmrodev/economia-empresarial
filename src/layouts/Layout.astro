---
import { ClientRouter } from 'astro:transitions';
import { getGalleryData, getPlaylist } from '../data/gallery';

interface Props {
  title?: string;
}

const { title = 'JuanFer Shop S.A.S. - Presentación' } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const folders = getGalleryData();
const playlist = getPlaylist(folders);
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <ClientRouter />
    <style is:global>
      * {
        box-sizing: border-box;
      }
      html, body {
        margin: 0;
        padding: 0;
        font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
        background: #090d16;
        color: #f1f5f9;
        width: 100%;
        min-height: 100vh;
        overflow-x: hidden;
        overflow-y: auto;
      }

      ::view-transition {
        overflow: hidden !important;
      }

      ::view-transition-old(root),
      ::view-transition-new(root) {
        animation: none !important;
        mix-blend-mode: normal !important;
      }

      ::view-transition-image-pair(*) {
        isolation: isolate;
      }

      ::view-transition-group(*) {
        animation-duration: 550ms;
        animation-timing-function: cubic-bezier(0.16, 1, 0.3, 1);
        overflow: hidden;
      }

      ::view-transition-old(*),
      ::view-transition-new(*) {
        animation-duration: 550ms;
        animation-timing-function: cubic-bezier(0.16, 1, 0.3, 1);
        mix-blend-mode: normal;
      }

      .glass-card {
        background: rgba(30, 41, 59, 0.65);
        backdrop-filter: blur(12px);
        -webkit-backdrop-filter: blur(12px);
        border: 1px solid rgba(255, 255, 255, 0.08);
        border-radius: 16px;
        transition: transform 0.2s ease, border-color 0.2s ease, box-shadow 0.2s ease;
      }
      .glass-card:hover {
        transform: translateY(-3px);
        border-color: rgba(255, 255, 255, 0.2);
        box-shadow: 0 16px 32px -8px rgba(0, 0, 0, 0.5);
      }

      .control-pill {
        background: rgba(15, 23, 42, 0.75);
        backdrop-filter: blur(8px);
        border: 1px solid rgba(255, 255, 255, 0.12);
        color: #94a3b8;
        padding: 0.35rem 0.75rem;
        border-radius: 999px;
        font-size: 0.75rem;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.2s ease;
        text-decoration: none;
      }
      .control-pill:hover {
        background: rgba(30, 41, 59, 0.9);
        color: #f8fafc;
        border-color: rgba(255, 255, 255, 0.25);
      }
      .control-pill.active {
        color: #38bdf8;
        border-color: rgba(56, 189, 248, 0.4);
        background: rgba(56, 189, 248, 0.12);
      }

      /* Estilos del Prompter / Panel de Práctica */
      #prompter-modal {
        position: fixed;
        bottom: 4rem;
        right: 1.5rem;
        width: min(480px, calc(100vw - 3rem));
        max-height: min(680px, calc(100vh - 5.5rem));
        background: rgba(11, 15, 25, 0.95);
        backdrop-filter: blur(18px);
        -webkit-backdrop-filter: blur(18px);
        border: 1px solid rgba(255, 255, 255, 0.15);
        border-radius: 18px;
        box-shadow: 0 25px 60px -10px rgba(0, 0, 0, 0.85), 0 0 0 1px rgba(56, 189, 248, 0.25);
        z-index: 100;
        display: none;
        flex-direction: column;
        color: #f1f5f9;
        overflow: hidden;
        animation: prompterSlideUp 0.2s cubic-bezier(0.16, 1, 0.3, 1);
      }
      #prompter-modal.visible {
        display: flex;
      }
      @keyframes prompterSlideUp {
        from { opacity: 0; transform: translateY(14px) scale(0.97); }
        to { opacity: 1; transform: translateY(0) scale(1); }
      }
      .prompter-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 0.85rem 1.25rem;
        border-bottom: 1px solid rgba(255, 255, 255, 0.08);
        background: rgba(15, 23, 42, 0.75);
      }
      .prompter-tabs {
        display: flex;
        background: rgba(15, 23, 42, 0.9);
        border-bottom: 1px solid rgba(255, 255, 255, 0.08);
        padding: 0.4rem;
        gap: 0.35rem;
      }
      .prompter-tab-btn {
        flex: 1;
        background: transparent;
        border: 1px solid transparent;
        color: #94a3b8;
        padding: 0.5rem 0.4rem;
        border-radius: 8px;
        font-size: 0.78rem;
        font-weight: 700;
        cursor: pointer;
        transition: all 0.2s;
        text-align: center;
      }
      .prompter-tab-btn:hover {
        color: #f8fafc;
        background: rgba(255, 255, 255, 0.05);
      }
      .prompter-tab-btn.active {
        color: #38bdf8;
        background: rgba(56, 189, 248, 0.15);
        border-color: rgba(56, 189, 248, 0.35);
      }
      .prompter-content {
        padding: 1.25rem;
        overflow-y: auto;
        font-size: 0.92rem;
        line-height: 1.6;
        color: #cbd5e1;
        flex: 1;
      }
      .prompter-content::-webkit-scrollbar {
        width: 6px;
      }
      .prompter-content::-webkit-scrollbar-thumb {
        background: rgba(255, 255, 255, 0.2);
        border-radius: 999px;
      }
      .prompter-quote {
        background: rgba(30, 41, 59, 0.5);
        border-left: 3px solid #38bdf8;
        padding: 0.65rem 0.85rem;
        margin: 0.6rem 0 0.85rem;
        border-radius: 0 8px 8px 0;
        font-size: 0.88rem;
        color: #f1f5f9;
      }
      .prompter-pill {
        display: inline-block;
        background: rgba(16, 185, 129, 0.15);
        color: #34d399;
        font-weight: 700;
        padding: 0.1rem 0.45rem;
        border-radius: 4px;
        font-size: 0.82rem;
      }
      .prompter-cue {
        margin-top: 1rem;
        padding: 0.5rem 0.75rem;
        border-radius: 8px;
        font-size: 0.8rem;
        font-weight: 600;
        background: rgba(245, 158, 11, 0.12);
        color: #fbbf24;
        border: 1px dashed rgba(245, 158, 11, 0.35);
      }
    </style>
  </head>
  <body>
    <slot />

    <!-- Barra flotante discreta de control para la presentación -->
    <div style="position: fixed; bottom: 1rem; right: 1.5rem; display: flex; align-items: center; gap: 0.5rem; z-index: 50;">
      <button id="toggle-prompter" class="control-pill" title="Abrir Guión / Prompter de Práctica (Tecla P)">
        🎙️ Guión
      </button>
      <a href={`${base}/`} class="control-pill" title="Volver al inicio (Tecla Home o Escape)">
        🏠 Módulos
      </a>
      <button id="toggle-autoplay" class="control-pill" title="Pausar o activar auto-recorrido (Barra Espaciadora)">
        ▶️ Auto
      </button>
      <button id="toggle-fullscreen" class="control-pill" title="Pantalla completa (Tecla F)">
        ⛶ Pantalla Completa
      </button>
    </div>

    <!-- Modal / Prompter para Ensayar la Presentación -->
    <div id="prompter-modal" aria-hidden="true">
      <div class="prompter-header">
        <div style="display: flex; align-items: center; gap: 0.5rem;">
          <span style="font-size: 1.1rem;">🎙️</span>
          <div>
            <h3 style="margin: 0; font-size: 0.95rem; font-weight: 700; color: #f8fafc;">Guión de Práctica</h3>
            <span style="font-size: 0.75rem; color: #94a3b8;">Pitch Comercial de Inversión • ISFD 166</span>
          </div>
        </div>
        <button id="close-prompter" style="background: transparent; border: none; color: #94a3b8; font-size: 1.25rem; cursor: pointer; padding: 0.2rem 0.5rem; border-radius: 6px; line-height: 1;">
          ✕
        </button>
      </div>

      <!-- Pestañas por Disertante -->
      <div class="prompter-tabs">
        <button class="prompter-tab-btn active" data-tab="juani">
          1. Juani (0-5m)
        </button>
        <button class="prompter-tab-btn" data-tab="juanm">
          2. Juan M. (5-10m)
        </button>
        <button class="prompter-tab-btn" data-tab="fer">
          3. Fer (10-15m)
        </button>
      </div>

      <!-- Contenido Juani -->
      <div id="tab-juani" class="prompter-content">
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.6rem;">
          <strong style="color: #38bdf8; font-size: 0.88rem;">PARTE 1: Juani — Modelo, Software y Marco Legal</strong>
          <span class="prompter-pill">00:00 - 05:00 min</span>
        </div>

        <p class="prompter-quote">
          "Buenas tardes. Presentamos <strong>JuanFer Shop S.A.S.</strong>: una oportunidad de inversión en e-commerce directo al consumidor, enfocada en productos de diseño, confort y tecnología para teletrabajadores y profesionales."
        </p>

        <p style="margin: 0.4rem 0;"><strong>1. Modelo Canvas y Mercado:</strong><br>
        Resolvemos las dos fallas del e-commerce actual: sitios lentos y entregas inciertas. Ofrecemos un catálogo curado de 15 productos de alta demanda con experiencia web ultra-rápida y entregas aseguradas en 24 horas.</p>

        <p style="margin: 0.4rem 0;"><strong>2. Software Propio (React 19 + Firestore vs WooCommerce):</strong></p>
        <ul style="padding-left: 1.2rem; margin: 0.2rem 0;">
          <li><strong>Velocidad &lt; 1,2s:</strong> Carga 4 veces más rápida que tiendas comunes; reduce el rebote un 42%.</li>
          <li><strong>Ahorro del 85% en cloud:</strong> Costo de servidor de apenas $2-$5 USD/mes (sin plugins pesados ni hosting costoso).</li>
          <li><strong>Control de stock atómico:</strong> Descuenta unidades en milisegundos en la nube, eliminando ventas duplicadas.</li>
          <li><strong>Vistas transaccionales:</strong> Carrito persistente en el navegador, checkout ágil y soporte omnicanal directo.</li>
        </ul>

        <p style="margin: 0.4rem 0;"><strong>3. Marco Legal (S.A.S. - Ley 27.349):</strong><br>
        Sociedad formalmente constituida con limitación de responsabilidad patrimonial para blindar a los inversores. Contempla $300.000 ARS de aranceles y edictos, lista para operar sin pasivos previos.</p>

        <div class="prompter-cue">
          🗣️ <strong>Pase a Juan M.:</strong> "Le paso la palabra a Juan M., que les detallará la estrategia de mercado, nuestro portafolio y la alianza logística."
        </div>
      </div>

      <!-- Contenido Juan M. -->
      <div id="tab-juanm" class="prompter-content" style="display: none;">
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.6rem;">
          <strong style="color: #38bdf8; font-size: 0.88rem;">PARTE 2: Juan M. — Estrategia, Portafolio y Logística</strong>
          <span class="prompter-pill">05:00 - 10:00 min</span>
        </div>

        <p class="prompter-quote">
          "Gracias, Juani. Ahora vemos cómo capturamos la demanda y operamos a escala nacional sin asumir costos fijos innecesarios."
        </p>

        <p style="margin: 0.4rem 0;"><strong>1. Investigación CACE, FODA Cruzada y Porter:</strong><br>
        Según CACE, el e-commerce crece a doble dígito y el usuario premia la inmediatez. En el FODA cruzamos nuestro software ágil y logística Full con la demanda de teletrabajo. Ante las fuerzas de Porter, no competimos por precios bajos destructivos: competimos con diseño, atención personalizada y garantía formal.</p>

        <p style="margin: 0.4rem 0;"><strong>2. Matriz BCG del Portafolio:</strong><br>
        Equilibramos los 15 artículos para garantizar liquidez y margen:</p>
        <ul style="padding-left: 1.2rem; margin: 0.2rem 0;">
          <li><strong>Estrellas:</strong> Auriculares ($99.990) y Reloj cuero ($149.500) — alto volumen y margen.</li>
          <li><strong>Vacas Lecheras:</strong> Mochila ($69.990), Botella ($29.990) y Smartband ($49.990) — flujo constante diario.</li>
          <li><strong>Interrogantes:</strong> Teclado mecánico ($129.990) y Silla ergonómica ($249.990) — ticket alto con pauta segmentada.</li>
          <li><strong>Perros / Estacionales:</strong> Bufanda ($34.990) — se liquida con ofertas en meses cálidos para rotar caja.</li>
        </ul>

        <p style="margin: 0.4rem 0;"><strong>3. Logística Mercado Envíos Full y Gantt:</strong></p>
        <ul style="padding-left: 1.2rem; margin: 0.2rem 0;">
          <li><strong>Almacenamiento robotizado:</strong> Depósito en Buenos Aires sin alquilar galpón propio ni pagar embaladores.</li>
          <li><strong>Insignia "Llega Mañana":</strong> Entregas en 24h a todo el país.</li>
          <li><strong>Packaging Bonificado ($0):</strong> Cajas reforzadas y bolsas de seguridad bonificadas al 100%.</li>
          <li><strong>Gantt a 8 semanas:</strong> Cronograma estricto desde habilitaciones legales hasta el lanzamiento con Meta y TikTok Ads.</li>
        </ul>

        <div class="prompter-cue">
          🗣️ <strong>Pase a Fer:</strong> "Ahora Fer les presentará la economía real: nómina laboral, unit economics y la proyección de rentabilidad."
        </div>
      </div>

      <!-- Contenido Fer -->
      <div id="tab-fer" class="prompter-content" style="display: none;">
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.6rem;">
          <strong style="color: #38bdf8; font-size: 0.88rem;">PARTE 3: Fer — Nómina, Unit Economics y Cierre</strong>
          <span class="prompter-pill">10:00 - 15:00 min</span>
        </div>

        <p class="prompter-quote">
          "Gracias, Juan. Un negocio debe ser sólido en sus números. Les comparto los datos financieros reales que demuestran la viabilidad de JuanFer Shop."
        </p>

        <p style="margin: 0.4rem 0;"><strong>1. Nómina Formal y Costos Fijos Mensuales:</strong><br>
        Presupuestamos con absoluta formalidad bajo convenios de trabajo:</p>
        <ul style="padding-left: 1.2rem; margin: 0.2rem 0;">
          <li><strong>5 puestos en blanco:</strong> 3 desarrolladores (CCT AGC) y 2 comerciales (CCT FAECyS).</li>
          <li><strong>Cargas reales (45% a 48%):</strong> F.931 AFIP (25%), ART (4%), aguinaldo proporcional y vacaciones.</li>
          <li><strong>Local comercial y servicios:</strong> Alquiler en Tandil ($700k), internet con backup 4G, cloud y estudio contable.</li>
          <li><strong>Costo fijo consolidado:</strong> <span class="prompter-pill">$17.063.797 ARS/mes</span> en régimen pleno ($12,3M en fase inicial).</li>
        </ul>

        <p style="margin: 0.4rem 0;"><strong>2. Margen de Contribución y Punto de Equilibrio:</strong></p>
        <ul style="padding-left: 1.2rem; margin: 0.2rem 0;">
          <li><strong>Precio promedio:</strong> $67.575 ARS | <strong>Costo variable:</strong> $41.163 ARS (CMV mayorista + comisiones + flete).</li>
          <li><strong>MCU:</strong> <span class="prompter-pill">$26.411,76 ARS libres por producto</span> (<strong>39,09%</strong> de margen bruto).</li>
          <li><strong>Punto de equilibrio fundacional:</strong> <strong>467 unidades/mes</strong> (~15 a 16 ventas diarias).</li>
          <li><strong>Punto de equilibrio pleno:</strong> <strong>647 unidades/mes</strong> (~21 ventas diarias).</li>
          <li><strong>Rotación continua:</strong> Con cobranza en 24-48h por Mercado Pago, el stock inicial de 166 unidades rota cada 7-8 días reinvirtiendo la caja.</li>
        </ul>

        <p style="margin: 0.4rem 0;"><strong>3. Inversión Inicial (Capex), Flujo y Oferta al Inversor:</strong></p>
        <ul style="padding-left: 1.2rem; margin: 0.2rem 0;">
          <li><strong>Inversión Capex:</strong> <span class="prompter-pill">$7.259.000 ARS</span> (stock mayorista + depósito garantía alquiler + setup), financiada equitativamente por los 3 socios ($2.420.000 c/u) con 0% deuda.</li>
          <li><strong>Resultados proyectados:</strong> 1° trimestre positivo con <strong>+$4,2M ARS</strong>. El ejercicio anual cierra con un <strong>Beneficio Neto de +$52.737.539 ARS</strong> (reinvirtiendo el 70% en inventario).</li>
        </ul>

        <p class="prompter-quote" style="border-left-color: #10b981;">
          "<strong>Conclusión para el Inversor:</strong> JuanFer Shop cuenta con barrera tecnológica propia, estructura liviana en activos fijos por logística Full, cero endeudamiento y rentabilidad probada desde el segundo mes. Es una unidad de negocio lista para operar y escalar. Muchas gracias."
        </p>
      </div>
    </div>

    <!-- Script de navegación interactiva y autoplay dinámico -->
    <script>
      import { navigate } from 'astro:transitions/client';

      let autoTimer = null;

      function getPlaylistData() {
        const playlistMeta = document.getElementById('gallery-playlist');
        if (!playlistMeta) return [];
        try {
          return JSON.parse(playlistMeta.textContent || '[]');
        } catch (e) {
          return [];
        }
      }

      function updateAutoplayButton() {
        const btn = document.getElementById('toggle-autoplay');
        if (!btn) return;
        const isRunning = sessionStorage.getItem('demo_autoplay') === 'true';
        if (isRunning) {
          btn.classList.add('active');
          btn.textContent = '⏸️ Pausar';
        } else {
          btn.classList.remove('active');
          btn.textContent = '▶️ Auto';
        }
      }

      function stepLoop() {
        const playlist = getPlaylistData();
        if (playlist.length === 0) return;
        if (autoTimer) clearTimeout(autoTimer);

        const isRunning = sessionStorage.getItem('demo_autoplay') === 'true';
        if (!isRunning) return;

        let currentPath = window.location.pathname.replace(/\/$/, '') || '/';
        let currentIndex = playlist.indexOf(currentPath);
        if (currentIndex === -1) currentIndex = 0;

        const nextIndex = (currentIndex + 1) % playlist.length;
        const nextUrl = playlist[nextIndex];

        autoTimer = setTimeout(() => {
          navigate(nextUrl);
        }, 3600);
      }

      function toggleAutoplay() {
        const current = sessionStorage.getItem('demo_autoplay') === 'true';
        sessionStorage.setItem('demo_autoplay', (!current).toString());
        updateAutoplayButton();
        if (!current) {
          stepLoop();
        } else {
          if (autoTimer) clearTimeout(autoTimer);
        }
      }

      function toggleFullscreen() {
        if (!document.fullscreenElement) {
          document.documentElement.requestFullscreen().catch(() => {});
        } else if (document.exitFullscreen) {
          document.exitFullscreen().catch(() => {});
        }
      }

      function handleKeydown(e) {
        if (['INPUT', 'TEXTAREA'].includes(document.activeElement?.tagName)) return;

        const playlist = getPlaylistData();
        if (playlist.length === 0) return;

        let currentPath = window.location.pathname.replace(/\/$/, '') || '/';
        let currentIndex = playlist.indexOf(currentPath);
        if (currentIndex === -1) currentIndex = 0;

        if (e.key === 'ArrowRight' || e.key === 'PageDown') {
          e.preventDefault();
          const nextIndex = (currentIndex + 1) % playlist.length;
          navigate(playlist[nextIndex]);
        } else if (e.key === 'ArrowLeft' || e.key === 'PageUp') {
          e.preventDefault();
          const prevIndex = (currentIndex - 1 + playlist.length) % playlist.length;
          navigate(playlist[prevIndex]);
        } else if (e.key === ' ' && e.target === document.body) {
          e.preventDefault();
          toggleAutoplay();
        } else if (e.key === 'f' || e.key === 'F') {
          toggleFullscreen();
        } else if (e.key === 'p' || e.key === 'P' || e.key === 'g' || e.key === 'G') {
          togglePrompter();
        } else if (e.key === 'Escape') {
          const modal = document.getElementById('prompter-modal');
          if (modal && modal.classList.contains('visible')) {
            togglePrompter();
          } else {
            navigate(playlist[0] || '/');
          }
        } else if (e.key === 'Home') {
          navigate(playlist[0] || '/');
        }
      }

      function togglePrompter() {
        const modal = document.getElementById('prompter-modal');
        const btn = document.getElementById('toggle-prompter');
        if (!modal) return;
        const isVis = modal.classList.toggle('visible');
        if (btn) btn.classList.toggle('active', isVis);
      }

      function setupPrompterTabs() {
        const tabBtns = document.querySelectorAll('.prompter-tab-btn');
        tabBtns.forEach(btn => {
          btn.addEventListener('click', () => {
            const tabTarget = btn.getAttribute('data-tab');
            tabBtns.forEach(b => b.classList.remove('active'));
            btn.classList.add('active');

            ['juani', 'juanm', 'fer'].forEach(id => {
              const panel = document.getElementById(`tab-${id}`);
              if (panel) {
                panel.style.display = id === tabTarget ? 'block' : 'none';
              }
            });
          });
        });

        const closeBtn = document.getElementById('close-prompter');
        if (closeBtn) {
          closeBtn.onclick = togglePrompter;
        }

        const openBtn = document.getElementById('toggle-prompter');
        if (openBtn) {
          openBtn.onclick = togglePrompter;
        }
      }

      document.removeEventListener('keydown', handleKeydown);
      document.addEventListener('keydown', handleKeydown);

      document.addEventListener('astro:page-load', () => {
        const btnAutoplay = document.getElementById('toggle-autoplay');
        if (btnAutoplay) {
          btnAutoplay.onclick = toggleAutoplay;
        }

        const btnFullscreen = document.getElementById('toggle-fullscreen');
        if (btnFullscreen) {
          btnFullscreen.onclick = toggleFullscreen;
        }

        setupPrompterTabs();
        updateAutoplayButton();
        stepLoop();
      });
    </script>

    <script id="gallery-playlist" type="application/json" set:html={JSON.stringify(playlist)} />
  </body>
</html>
