---
import Layout from '../../layouts/Layout.astro';
import { getGalleryData, APP_BASE } from '../../data/gallery';

export function getStaticPaths() {
  const folders = getGalleryData();
  const paths = [];

  for (const folder of folders) {
    paths.push({
      params: { id: folder.id },
      props: { folder }
    });

    // Soporte de alias hacia atrás por si el navegador tenía la URL previa en el historial
    if (folder.id === 'evaluacion-financiera') {
      paths.push({ params: { id: 'evaluacion-financiera-y-retorno' }, props: { folder } });
    }
    if (folder.id === 'tecnologia-y-plataforma') {
      paths.push({ params: { id: 'plataforma-web' }, props: { folder } });
    }
    if (folder.id === 'costos-laborales-y-logistica') {
      paths.push({ params: { id: 'operaciones-y-logistica' }, props: { folder } });
    }
  }

  return paths;
}

const { folder } = Astro.props;
const count = folder.items.length;

// Calculamos columnas y filas dinámicas para que TODO quepa sin scroll en 100vh
let cols = 2;
if (count === 1) cols = 1;
else if (count <= 2) cols = 2;
else if (count <= 4) cols = 2;
else if (count <= 6) cols = 3;
else if (count <= 9) cols = 3;
else if (count <= 12) cols = 4;
else cols = 5;

const rows = Math.ceil(count / cols);
---
<Layout title={`${folder.title} - JuanFer Shop`}>
  <main 
    style={`width: 100vw; min-height: 100vh; padding: 4.5rem 2rem 2.5rem 2rem; display: flex; flex-direction: column; justify-content: center; align-items: center; box-sizing: border-box; position: relative; view-transition-name: folder-card-${folder.id};`}
  >
    <!-- Header con botón volver y título del módulo -->
    <div style="position: absolute; top: 1.25rem; left: 2rem; display: flex; align-items: center; gap: 0.85rem; z-index: 20;">
      <a 
        href={`${APP_BASE}/`} 
        style="display: inline-flex; align-items: center; justify-content: center; width: 34px; height: 34px; border-radius: 8px; background: rgba(255, 255, 255, 0.08); border: 1px solid rgba(255, 255, 255, 0.15); color: #f8fafc; text-decoration: none; font-size: 1rem; font-weight: 700; transition: background 0.2s;"
        title="Volver a los módulos"
      >
        &larr;
      </a>
      <span style={`width: 12px; height: 12px; border-radius: 50%; background: ${folder.themeColor}; box-shadow: 0 0 12px ${folder.themeColor};`}></span>
      <h2 style="margin: 0; font-size: 1.2rem; font-weight: 700; color: #f8fafc; letter-spacing: -0.01em;">
        {folder.title}
      </h2>
      <span style="font-size: 0.85rem; color: #64748b; margin-left: 0.2rem;">
        ({folder.items.length} {folder.items.length === 1 ? 'pantalla' : 'pantallas'})
      </span>
    </div>
    
    <!-- Grilla calculada para ocupar la ventana -->
    <div 
      style={`display: grid; grid-template-columns: repeat(${cols}, minmax(0, 1fr)); grid-template-rows: repeat(${rows}, minmax(0, 1fr)); gap: 1.2rem; width: 100%; height: calc(100vh - 6.5rem); max-height: calc(100vh - 6.5rem); max-width: 1600px; box-sizing: border-box;`}
    >
      {folder.items.map((item) => (
        <a 
          href={`${APP_BASE}/pantalla/${folder.id}/${item.id}`} 
          style="text-decoration: none; color: inherit; display: block; width: 100%; height: 100%; min-height: 0;"
          title={`Ver ${item.title}`}
        >
          <div 
            class="glass-card" 
            style="overflow: hidden; border-radius: 14px; box-shadow: 0 12px 30px rgba(0,0,0,0.4); width: 100%; height: 100%; display: flex; align-items: center; justify-content: center; background: #0b0f19; position: relative;"
          >
            <img 
              src={item.url} 
              alt={item.title} 
              style={`width: 100%; height: 100%; object-fit: contain; display: block; view-transition-name: ${item.transitionName};`}
            />
            <div style="position: absolute; bottom: 0; left: 0; right: 0; padding: 0.4rem 0.8rem; background: linear-gradient(to top, rgba(0,0,0,0.92) 0%, rgba(0,0,0,0.7) 70%, transparent 100%); color: #e2e8f0; font-size: 0.82rem; font-weight: 600; text-align: center; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">
              {item.title}
            </div>
          </div>
        </a>
      ))}
    </div>
  </main>
</Layout>
