---
import Layout from '../layouts/Layout.astro';
import { getGalleryData, APP_BASE } from '../data/gallery';

const folders = getGalleryData();
---
<Layout title="JuanFer Shop S.A.S. - Presentación Economía Empresarial">
  <main style="width: 100%; min-height: 100vh; max-width: 1400px; margin: 0 auto; padding: 3rem 2rem 5rem 2rem; display: flex; flex-direction: column; justify-content: center; box-sizing: border-box;">
    
    <div style="margin-bottom: 2.2rem; display: flex; justify-content: space-between; align-items: flex-end; flex-wrap: wrap; gap: 1rem; border-bottom: 1px solid rgba(255, 255, 255, 0.08); padding-bottom: 1.5rem;">
      <div>
        <div style="font-size: 0.82rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.08em; color: #38bdf8; margin-bottom: 0.4rem;">
          Plan de Negocios &amp; Pitch Comercial
        </div>
        <h1 style="margin: 0; font-size: clamp(1.8rem, 3.2vw, 2.5rem); font-weight: 800; color: #f8fafc; letter-spacing: -0.02em;">
          Defensa Ejecutiva JuanFer Shop S.A.S.
        </h1>
      </div>
      <div style="display: flex; gap: 0.6rem; font-size: 0.85rem; color: #94a3b8;">
        <span style="background: rgba(255,255,255,0.05); padding: 0.35rem 0.75rem; border-radius: 6px; border: 1px solid rgba(255,255,255,0.08);">6 Módulos Temáticos</span>
        <span style="background: rgba(255,255,255,0.05); padding: 0.35rem 0.75rem; border-radius: 6px; border: 1px solid rgba(255,255,255,0.08);">15 Minutos de Exposición</span>
      </div>
    </div>

    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(350px, 1fr)); gap: 1.5rem; width: 100%;">
      {folders.map((folder, idx) => (
        <a 
          href={`${APP_BASE}/modulo/${folder.id}`} 
          style={`text-decoration: none; color: inherit; display: block; view-transition-name: folder-card-${folder.id};`}
        >
          <div 
            class="module-card" 
            style="padding: 1.8rem; height: 100%; display: flex; flex-direction: column; justify-content: space-between; border-radius: 14px; background: rgba(15, 23, 42, 0.75); border: 1px solid rgba(255, 255, 255, 0.08); box-shadow: 0 4px 20px -2px rgba(0, 0, 0, 0.5); transition: all 0.25s ease;"
          >
            <div>
              <div style="margin-bottom: 0.8rem;">
                <span style="font-size: 0.8rem; font-weight: 800; color: #64748b; letter-spacing: 0.05em;">
                  0{idx + 1}
                </span>
              </div>

              <h2 style="font-size: 1.3rem; margin: 0 0 0.65rem; color: #f8fafc; font-weight: 700; line-height: 1.3; letter-spacing: -0.01em;">
                {folder.title}
              </h2>
              <p style="color: #94a3b8; font-size: 0.92rem; line-height: 1.55; margin: 0;">
                {folder.description}
              </p>
            </div>
          </div>
        </a>
      ))}
    </div>
  </main>
</Layout>

<style>
  .module-card:hover {
    transform: translateY(-3px);
    border-color: rgba(56, 189, 248, 0.35);
    background: rgba(30, 41, 59, 0.65);
    box-shadow: 0 14px 28px -6px rgba(0, 0, 0, 0.7);
  }
</style>
