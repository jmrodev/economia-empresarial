---
import Layout from '../layouts/Layout.astro';
import { getGalleryData, APP_BASE } from '../data/gallery';

const folders = getGalleryData();
---
<Layout title="JuanFer Shop S.A.S. - Presentación Economía Empresarial">
  <main style="width: 100%; min-height: 100vh; max-width: 1350px; margin: 0 auto; padding: 2.5rem 1.5rem 5rem 1.5rem; display: flex; flex-direction: column; justify-content: center; box-sizing: border-box;">
    <header style="margin-bottom: 2rem;">
      <div style="display: flex; gap: 0.6rem; align-items: center; margin-bottom: 0.8rem; flex-wrap: wrap;">
        <span style="background: rgba(56, 189, 248, 0.15); border: 1px solid rgba(56, 189, 248, 0.35); color: #38bdf8; padding: 0.35rem 0.85rem; border-radius: 999px; font-size: 0.82rem; font-weight: 700;">
          JuanFer Shop S.A.S.
        </span>
        <span style="background: rgba(129, 140, 248, 0.12); border: 1px solid rgba(129, 140, 248, 0.25); color: #a5b4fc; padding: 0.35rem 0.85rem; border-radius: 999px; font-size: 0.82rem; font-weight: 600;">
          Economía Empresarial • ISFD 166
        </span>
      </div>
      <h1 style="font-size: clamp(1.8rem, 3.5vw, 2.8rem); font-weight: 800; margin: 0 0 0.6rem; letter-spacing: -0.02em; color: #f8fafc;">
        Presentación para Emprendedores
      </h1>
      <p style="color: #94a3b8; font-size: 1.05rem; max-width: 820px; line-height: 1.5; margin: 0;">
        Vistas generadas automáticamente a partir de las carpetas e imágenes de <code>public/galeria/</code> con View Transitions.
      </p>
    </header>

    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap: 1.5rem; width: 100%;">
      {folders.map((folder) => (
        <a 
          href={`${APP_BASE}/modulo/${folder.id}`} 
          style={`text-decoration: none; color: inherit; display: block; view-transition-name: folder-card-${folder.id};`}
        >
          <div 
            class="glass-card" 
            style="padding: 1.8rem; height: 100%; display: flex; flex-direction: column; justify-content: space-between; border-top: 4px solid; word-break: break-word;"
            style={{ borderTopColor: folder.themeColor }}
          >
            <div>
              <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1rem; gap: 0.5rem; flex-wrap: wrap;">
                <span 
                  style={`background: ${folder.themeColor}22; color: ${folder.themeColor}; border: 1px solid ${folder.themeColor}44; padding: 0.25rem 0.75rem; border-radius: 999px; font-size: 0.8rem; font-weight: 600;`}
                >
                  Módulo
                </span>
                <span style="font-size: 0.85rem; color: #64748b; font-weight: 600;">
                  {folder.items.length} {folder.items.length === 1 ? 'pantalla' : 'pantallas'}
                </span>
              </div>

              <h2 style="font-size: 1.35rem; margin: 0 0 0.5rem; color: #f8fafc; font-weight: 700; line-height: 1.3;">
                {folder.title}
              </h2>
              <p style="color: #94a3b8; font-size: 0.92rem; line-height: 1.5; margin: 0;">
                {folder.description}
              </p>
            </div>

            <div style="margin-top: 1.8rem; display: flex; align-items: center; gap: 0.5rem; font-weight: 600; font-size: 0.9rem;" style={{ color: folder.themeColor }}>
              <span>Ver pantallas</span>
              <span>&rarr;</span>
            </div>
          </div>
        </a>
      ))}
    </div>
  </main>
</Layout>
